<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Not required: lets the APK install on any device, the app just shows
         a message if no USB host support / camera is present. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Android 9+ only grants USB access to video class devices (UVC
         cameras) to apps holding CAMERA. The app never uses the phone's own
         cameras. required="false" keeps the APK installable on devices
         without a built-in camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="Endocam"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <!-- configChanges: rotating the phone must not recreate the activity,
             which would close and reopen the USB camera. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Offers to open the app when the camera is plugged in, and
                 lets the user tick "always" to skip the permission prompt. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
    </application>
</manifest>
